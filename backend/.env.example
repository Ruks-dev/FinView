PORT=3000

# Use the hosted connection string for a shared team database.
# Leave DATABASE_URL empty when using the local PostgreSQL settings below.
DATABASE_URL=
DB_SSL=false

DB_USER=postgres
DB_HOST=localhost
DB_NAME=fin_view
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# Comma-separated frontend origins for production deployments.
FRONTEND_URL=http://localhost:5173